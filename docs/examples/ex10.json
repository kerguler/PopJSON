{
    "model": {
        "title": "Density-dependent population dynamics of Aedes albopictus",
        "type": "Population",
        "url": "https://github.com/kerguler/Population",
        "deterministic": true,
        "parameters": {
            "algorithm": "Population",
            "istep": 0.01
        }
    },
    "externals": [
        {
            "id": "breeding_site",
            "file": "ex9.dylib",
            "numenv": 1,
            "numpar": 2,
            "numpop": 1
        }
    ],
    "environ": [
        {
            "id": "temp",
            "name": "Temperature of the breeding pool (in °C)"
        },{
            "id": "prec",
            "name": "Daily total precipitation (in mm)"
        }
    ],
    "functions": {
        "briere1": ["define", ["T","a","L","R"], ["?",["<=","T","L"],"365.0", ["?",[">=","T","R"],"365.0", ["min","365.0",["max","1.0", ["/","1.0",["exp", ["+","a",["log","T"],["log",["-","T","L"]],["*","0.5",["log",["-","R","T"]]]]]]]]]]]
    },
    "parameters": [
        {
            "id": "d2m_a",
            "constant": false,
            "name": "Larva development mean (a)",
            "value": -12
        },{
            "id": "d2m_b",
            "constant": false,
            "name": "Larva development mean (b)",
            "value": 283.15
        },{
            "id": "d2m_c",
            "constant": false,
            "name": "Larva development mean (c)",
            "value": 308.15
        },{
            "id": "bs_alpha",
            "constant": false,
            "name": "Breeding site volume accumulation coefficient",
            "value": 1.0
        },{
            "id": "bs_beta",
            "constant": false,
            "name": "Breeding site volume evaporation coefficient",
            "value": 0.5
        }
    ],
    "evaluate": [
        {
            "id": "bsitevol",
            "value": ["breeding_site", {
                "y0": ["bsvol"],
                "pr": ["bs_alpha","bs_beta"],
                "envir": [["prec", "TIME_1"]]
            }]
        }
    ],
    "intermediates": [
        {
            "id": "bsvol",
            "value": ["bsitevol", 0]
        },{
            "id": "bscoef",
            "value": ["-", "1.0", ["/", "1.0", "larva", ["+", "larva", "bsvol"]]]
        },{
            "id": "d2m",
            "value": ["briere1", ["temp", "TIME_1"], "d2m_a", "d2m_b", "d2m_c"]
        }
    ],
    "populations": [
        {
            "id": "larva",
            "name": "The larva stage",
            "processes": [
                {
                    "id": "larva_death",
                    "name": "Larva mortality",
                    "arbiter": "NOAGE_CONST",
                    "evaluate": [
                        {
                            "id": "bsitevolmort",
                            "value": ["breeding_site", {
                                "y0": ["bsvol"],
                                "pr": ["bs_alpha","bs_beta"],
                                "envir": [["prec", "TIME_1"]]
                            }]
                        }
                    ],
                    "intermediates": [
                        {
                            "id": "coefmort",
                            "value": ["-", "1.0", ["/", "larva", ["+", "1.0", "larva", ["bsitevolmort", 0]]]]
                        }
                    ],
                    "value": ["coefmort"]
                },{
                    "id": "larva_dev",
                    "name": "Larva development time",
                    "arbiter": "ACC_ERLANG",
                    "evaluate": [
                        {
                            "id": "bsitevoldev",
                            "value": ["breeding_site", {
                                "y0": ["bsvol"],
                                "pr": ["bs_alpha","bs_beta"],
                                "envir": [["prec", "TIME_1"]]
                            }]
                        }
                    ],
                    "intermediates": [
                        {
                            "id": "coefdev",
                            "value": ["-", "1.0", ["/", "larva", ["+", "1.0", "larva", ["bsitevoldev", 0]]]]
                        },{
                            "id": "d2m_coef",
                            "value": ["*", "coefdev", "d2m"]
                        }
                    ],
                    "value": ["d2m_coef", ["sqrt", "d2m_coef"]],
                    "hazpar": true
                }
            ]
        }
    ]
}
