{
    "model": {
        "title": "Density-dependent population dynamics of Aedes albopictus",
        "type": "Population",
        "url": "https://github.com/kerguler/Population",
        "deterministic": true,
        "parameters": {
            "algorithm": "Population",
            "istep": 0.01
        }
    },
    "externals": [
        {
            "id": "breeding_site",
            "file": "ex9.dylib",
            "numenv": 1,
            "numpar": 2,
            "numpop": 1
        }
    ],
    "environ": [
        {
            "id": "temp",
            "name": "Temperature of the breeding pool (in °C)"
        },{
            "id": "prec",
            "name": "Daily total precipitation (in mm)"
        }
    ],
    "functions": {
        "briere1": ["define", ["T","a","L","R"], ["?",["<=","T","L"],"365.0", ["?",[">=","T","R"],"365.0", ["min","365.0",["max","1.0", ["/","1.0",["exp", ["+","a",["log","T"],["log",["-","T","L"]],["*","0.5",["log",["-","R","T"]]]]]]]]]]]
    },
    "parameters": [
        {
            "id": "d2m_a",
            "constant": false,
            "name": "Larva development mean (a)",
            "value": -12
        },{
            "id": "d2m_b",
            "constant": false,
            "name": "Larva development mean (b)",
            "value": 283.15
        },{
            "id": "d2m_c",
            "constant": false,
            "name": "Larva development mean (c)",
            "value": 308.15
        },{
            "id": "d2s_c",
            "constant": false,
            "name": "Larva development stdev (c)",
            "value": 0.2
        }
    ],
    "evaluate": [
        {
            "id": "bsitevol",
            "value": ["breeding_site", {
                "y0": "bsvol",
                "envir": ["temp", "TIME_1"]
            }]
        }
    ],
    "intermediates": [
        {
            "id": "bsvol",
            "value": ["bsitevol", 0]
        },{
            "id": "d2m",
            "value": ["briere1", ["temp", "TIME_1"], "d2m_a", "d2m_b", "d2m_c"]
        }, {
            "id": "d2s",
            "value": ["*", "d2s_c", "d2m"]
        }
    ],
    "populations": [
        {
            "id": "larva",
            "name": "The larva stage",
            "processes": [
                {
                    "id": "larva_death",
                    "name": "Larva mortality",
                    "arbiter": "NOAGE_CONST",
                    "evaluate": [
                        {
                            "id": "bsitevolproc",
                            "value": ["breeding_site", {
                                "y0": "bsvol",
                                "envir": ["temp", "TIME_1"]
                            }]
                        }
                    ],
                    "value": [["/", "larva", ["+", "larva", "bsvol", ["bsitevolproc", 0]]]]
                },{
                    "id": "larva_dev",
                    "name": "Larva development time",
                    "arbiter": "ACC_ERLANG",
                    "value": ["d2m", "d2s"]
                }
            ]
        }
    ]
}
